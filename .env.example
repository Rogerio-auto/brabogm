# ── Database (em produção, usa o PostgreSQL da VPS) ──
DATABASE_URL=postgresql://postgres:password@localhost:5432/brabogm
PG_USER=postgres
PG_PASS=password
PG_DB_BRABOGM=brabogm

# ── API ──
PORT=3001
NODE_ENV=development
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ── n8n Integration ──
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=change-me-in-production
N8N_WEBHOOK_ADMIN_ACTION=
N8N_WEBHOOK_NEW_LEAD=
N8N_API_URL=https://auto.brabogm.cloud
N8N_APIKEY_MORAL=define-in-secret-manager

# ── Frontend (for Vite) ──
VITE_API_URL=http://localhost:3001

# ── Domínios (produção) ──
DOMAIN_WEB=app.seudominio.com
DOMAIN_PGADMIN=pgadmin.seudominio.com
FRONTEND_URL=https://app.seudominio.com

# ── PgAdmin (produção) ──
PGADMIN_EMAIL=admin@seudominio.com
PGADMIN_PASSWORD=change-me

# ── Version ──
APP_VERSION=latest
